ENVIRONMENT=development
DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443
DATABASE_URL=postgresql+asyncpg://store_user:replace-with-local-password@localhost:5432/store_db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
CORS_ORIGINS=https://example.com
COOKIE_SECURE=true
POSTGRES_DB=store_db
POSTGRES_USER=store_user
POSTGRES_PASSWORD=replace-with-a-strong-password
VITE_API_ORIGIN=

# IMPORTANT:
# - Populate ADMIN_PASSWORD_HASH with a valid Argon2 hash before enabling admin login.
# - Do not reuse a test hash or commit a real .env file with secrets.
# - Set DOMAIN to your public domain after its DNS points to this host; Caddy
#   then obtains and renews a publicly trusted certificate automatically.
# - Set CORS_ORIGINS to the exact public origin, such as https://example.com.
# - Use COOKIE_SECURE=false only for local HTTP verification.
# - The Dockerized frontend uses same-origin /api and /uploads paths.
# - Docker Compose connects to postgres:5432 internally; the database and
#   backend ports are not published on the host.
